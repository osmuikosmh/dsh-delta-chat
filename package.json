{
  "name": "dsh-delta-chat",
  "version": "1.0.0",
  "description": "让 DSH 以“大肥鱼”的人设自动创建 Delta Chat 账号，并像真人网友一样和好友聊天：深度思考、按需联网搜索、真人口吻与回复节奏。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "bin",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "delta-chat",
    "chatmail",
    "ai-friend"
  ],
  "license": "MIT"
}
